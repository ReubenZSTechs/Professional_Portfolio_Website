# Copy to .env (never commit .env). The same names go into Vercel → Project → Settings → Environment Variables.

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional model overrides (defaults live in backend/src/core/config.py)
# GEMINI_CHAT_MODEL=
# GEMINI_REWRITE_MODEL=
# GEMINI_EMBED_MODEL=
# Fallbacks, tried in order when a model is overloaded (503), rate-limited (429), retired (404)
# or times out. Comma-separated:
# GEMINI_CHAT_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# GEMINI_REWRITE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=25

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
# Server-only secret. Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend, for contact-form emails (https://resend.com/api-keys) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=reuben.zachary.rz@gmail.com
# Sender address; use onboarding@resend.dev until you verify a domain
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Security / runtime (docs/security.md) ---
# Salt for hashing visitor IPs before they are stored (rate limiting). Use a long random string:
#   openssl rand -hex 32
IP_HASH_SALT=
# Signs chat sessions and assistant answers (stops forged chat history). Required when deployed:
#   openssl rand -hex 32
CHAT_SIGNING_SECRET=
# "production" hides the API docs and makes every security check fail closed.
# (Vercel previews are treated the same automatically via VERCEL_ENV.)
ENVIRONMENT=development

# --- Cloudflare Turnstile bot check (dash.cloudflare.com → Turnstile → Add widget) ---
# Required when deployed. Locally you can leave both empty (check skipped) or use Cloudflare's
# always-pass test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Abuse limits (defaults shown) ---
# RATE_LIMIT_CHAT_DAILY_GLOBAL=500   # questions per UTC day, whole site
# RATE_LIMIT_CHAT_MAX=20             # per visitor per 10 minutes
# RATE_LIMIT_CHAT_BURST_MAX=5        # per visitor per minute
# Extra origins allowed to call the API (comma-separated), e.g. a custom domain:
# ALLOWED_ORIGINS=https://reuben.dev

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
